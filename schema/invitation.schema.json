{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://invito.app/schemas/invitation.schema.json",
  "title": "EventInvitation",
  "description": "Structured schema definition for event invitations in the Invito platform",
  "type": "object",
  "required": ["version", "slug", "title", "date_start", "location", "theme"],
  "properties": {
    "version": {
      "type": "string",
      "default": "1.0",
      "description": "Schema version"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "URL-friendly unique identifier (e.g. sarah-and-alex-wedding)"
    },
    "title": {
      "type": "string",
      "description": "Main title of the event"
    },
    "subtitle": {
      "type": "string",
      "description": "Optional secondary headline or invitation greeting"
    },
    "hosts": {
      "type": "array",
      "items": { "type": "string" },
      "description": "List of host names"
    },
    "description": {
      "type": "string",
      "description": "Welcome message or narrative for guests"
    },
    "date_start": {
      "type": "string",
      "format": "date-time",
      "description": "Start timestamp in ISO-8601 format"
    },
    "date_end": {
      "type": "string",
      "format": "date-time",
      "description": "End timestamp in ISO-8601 format"
    },
    "timezone": {
      "type": "string",
      "default": "UTC",
      "description": "IANA timezone identifier (e.g. America/New_York, Europe/Paris)"
    },
    "location": {
      "type": "object",
      "required": ["name", "address"],
      "properties": {
        "name": { "type": "string", "description": "Venue name" },
        "address": { "type": "string", "description": "Full street address" },
        "map_url": { "type": "string", "description": "Google Maps or OpenStreetMap direct link" },
        "directions_note": { "type": "string", "description": "Parking, shuttle, or navigation instructions" }
      }
    },
    "theme": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": {
          "type": "string",
          "enum": ["botanical-elegance", "midnight-soiree", "modern-minimal", "golden-sunset"],
          "description": "Pre-defined theme identifier"
        },
        "palette_override": {
          "type": "object",
          "properties": {
            "primary": { "type": "string" },
            "background": { "type": "string" },
            "text": { "type": "string" },
            "accent": { "type": "string" },
            "card_bg": { "type": "string" }
          }
        },
        "font_heading": { "type": "string" },
        "font_body": { "type": "string" },
        "custom_css": { "type": "string" }
      }
    },
    "music": {
      "$ref": "#/definitions/music_config",
      "description": "Optional background audio track and playback controls"
    },
    "splash_screen": {
      "$ref": "#/definitions/splash_screen_config",
      "description": "Optional tap-to-open welcome screen and envelope gate"
    },
    "sections": {
      "description": "Ordered list of modular invitation section building blocks",
      "oneOf": [
        {
          "type": "array",
          "items": {
            "oneOf": [
              { "$ref": "#/definitions/hero_section" },
              { "$ref": "#/definitions/details_section" },
              { "$ref": "#/definitions/quote_section" },
              { "$ref": "#/definitions/text_section" },
              { "$ref": "#/definitions/image_section" },
              { "$ref": "#/definitions/carousel_section" },
              { "$ref": "#/definitions/timeline_section" },
              { "$ref": "#/definitions/dress_code_section" },
              { "$ref": "#/definitions/rsvp_section" },
              { "$ref": "#/definitions/rsvp_external_section" },
              { "$ref": "#/definitions/faqs_section" },
              { "$ref": "#/definitions/gift_registry_section" },
              { "$ref": "#/definitions/closing_section" }
            ]
          }
        },
        {
          "type": "object",
          "description": "Legacy map of section objects"
        }
      ]
    }
  },
  "definitions": {
    "section_surface": {
      "type": "string",
      "enum": ["auto", "light", "contrast"],
      "default": "auto",
      "description": "Visual surface background tone ('auto' alternates dynamically, 'light' forces bright background, 'contrast' forces dark/tinted background)"
    },
    "music_config": {
      "type": "object",
      "required": ["url"],
      "properties": {
        "url": {
          "type": "string",
          "description": "Local path (/uploads/...) or public HTTPS URL to the audio file"
        },
        "title": {
          "type": "string",
          "description": "Song title or artist name displayed on the floating control (e.g. 'A Thousand Years - Christina Perri')"
        },
        "autoplay": {
          "type": "boolean",
          "default": true,
          "description": "Whether playback should start immediately upon the initial user interaction"
        },
        "loop": {
          "type": "boolean",
          "default": true,
          "description": "Whether the audio track should repeat seamlessly when finished"
        }
      }
    },
    "splash_screen_config": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true,
          "description": "Whether to display the splash screen before showing the invitation"
        },
        "title": {
          "type": "string",
          "description": "Headline text on the splash card (e.g. 'You are Invited', 'Lucas is turning 30')"
        },
        "message": {
          "type": "string",
          "description": "Warm introductory note or guest instructions"
        },
        "button_text": {
          "type": "string",
          "default": "Open Invitation",
          "description": "Call-to-action text on the envelope button"
        },
        "background_image_url": {
          "type": "string",
          "description": "Optional custom background or envelope texture photo"
        }
      }
    },
    "hero_section": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "enum": ["hero"] },
        "surface": { "$ref": "#/definitions/section_surface" },
        "layout": {
          "type": "string",
          "enum": ["full-bleed", "banner"],
          "default": "full-bleed",
          "description": "Visual hero layout variant: 'full-bleed' (magazine cover overlay, default) or 'banner' (split image banner on top + text below)"
        },
        "eyebrow": { "type": "string", "description": "Short label or event context above title (e.g. Wedding Celebration, Chapter 30)" },
        "vibe": { "type": "string", "description": "One-liner describing the event atmosphere or spirit" },
        "badge": { "type": "string", "description": "Custom event details or meta badge text (defaults to date & time)" },
        "cover_image_url": { "type": "string", "description": "Full-width hero cover image or background photo" },
        "banner_image_url": { "type": "string", "description": "Optional section banner or header accent image" },
        "show_countdown": { "type": "boolean", "default": true }
      }
    },
    "details_section": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "enum": ["details"] },
        "surface": { "$ref": "#/definitions/section_surface" },
        "date_label": { "type": "string", "description": "Optional custom header label for date/time (defaults to 'When')" },
        "location_label": { "type": "string", "description": "Optional custom header label for location (defaults to 'Where')" },
        "show_map_link": { "type": "boolean", "default": true },
        "show_calendar_button": { "type": "boolean", "default": true }
      }
    },
    "quote_section": {
      "type": "object",
      "required": ["type", "text"],
      "properties": {
        "type": { "type": "string", "enum": ["quote"] },
        "surface": { "$ref": "#/definitions/section_surface" },
        "text": { "type": "string", "description": "Quote or literary statement" },
        "author": { "type": "string", "description": "Optional author or attribution for quotes" }
      }
    },
    "text_section": {
      "type": "object",
      "required": ["type", "text"],
      "properties": {
        "type": { "type": "string", "enum": ["text"] },
        "surface": { "$ref": "#/definitions/section_surface" },
        "title": { "type": "string", "description": "Optional announcement or note title" },
        "text": { "type": "string", "description": "Plain text content or announcement" },
        "align": { "type": "string", "enum": ["left", "center", "right"], "description": "Text alignment" }
      }
    },
    "image_section": {
      "type": "object",
      "required": ["type", "url"],
      "properties": {
        "type": { "type": "string", "enum": ["image"] },
        "surface": { "$ref": "#/definitions/section_surface" },
        "url": { "type": "string", "description": "Image URL or static asset path" },
        "caption": { "type": "string", "description": "Optional caption below image" },
        "alt": { "type": "string", "description": "Accessible alt text for the image" }
      }
    },
    "carousel_section": {
      "type": "object",
      "required": ["type", "images"],
      "properties": {
        "type": { "type": "string", "enum": ["carousel"] },
        "surface": { "$ref": "#/definitions/section_surface" },
        "title": { "type": "string", "description": "Optional heading for the gallery/carousel section" },
        "aspect_ratio": {
          "type": "string",
          "enum": ["4:3", "16:9", "1:1", "4:5", "3:4", "9:16"],
          "default": "4:3",
          "description": "Aspect ratio of the carousel slide frame"
        },
        "fit": {
          "type": "string",
          "enum": ["contain", "cover"],
          "default": "contain",
          "description": "Image fit strategy ('contain' uses atmospheric ambient backdrop, 'cover' crops edge-to-edge)"
        },
        "images": {
          "type": "array",
          "description": "List of images displayed in the carousel",
          "items": {
            "type": "object",
            "required": ["url"],
            "properties": {
              "url": { "type": "string", "description": "Image URL or static asset path" },
              "caption": { "type": "string", "description": "Optional caption or story text" },
              "alt": { "type": "string", "description": "Accessible alt text for screen readers" }
            }
          }
        }
      }
    },
    "timeline_section": {
      "type": "object",
      "required": ["type", "items"],
      "properties": {
        "type": { "type": "string", "enum": ["timeline"] },
        "surface": { "$ref": "#/definitions/section_surface" },
        "title": { "type": "string", "description": "Timeline section heading" },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["time", "title"],
            "properties": {
              "time": { "type": "string", "description": "Display time (e.g. 4:00 PM)" },
              "title": { "type": "string", "description": "Event segment title" },
              "description": { "type": "string" },
              "icon": { "type": "string", "description": "Optional icon keyword" }
            }
          }
        }
      }
    },
    "dress_code_section": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "enum": ["dress_code"] },
        "surface": { "$ref": "#/definitions/section_surface" },
        "title": { "type": "string", "description": "Section title (e.g. Dress Code)" },
        "name": { "type": "string", "description": "Dress code label/name (e.g. Formal Black Tie, Cocktail Attire)" },
        "description": { "type": "string" },
        "palette_hints": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Hex color codes or color names suggested for guests"
        }
      }
    },
    "rsvp_section": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "enum": ["rsvp"] },
        "surface": { "$ref": "#/definitions/section_surface" },
        "enabled": { "type": "boolean", "default": true },
        "deadline": { "type": "string", "format": "date-time" },
        "max_party_size": { "type": "integer", "default": 2, "minimum": 1, "maximum": 10 },
        "ask_dietary": { "type": "boolean", "default": true },
        "ask_song_request": { "type": "boolean", "default": false },
        "custom_note": { "type": "string" }
      }
    },
    "rsvp_external_section": {
      "type": "object",
      "required": ["type", "form_url"],
      "properties": {
        "type": { "type": "string", "enum": ["rsvp_external"] },
        "surface": { "$ref": "#/definitions/section_surface" },
        "enabled": { "type": "boolean", "default": true },
        "title": { "type": "string", "description": "RSVP section heading" },
        "prompt": { "type": "string", "description": "Prompt text inviting guests to confirm attendance" },
        "form_url": { "type": "string", "description": "URL to external form (e.g. Google Forms, Tally, Typeform)" },
        "button_label": { "type": "string", "description": "CTA button label (e.g. Completar Formulario)" },
        "deadline": { "type": "string", "format": "date-time" },
        "contribution_note": { "type": "string", "description": "Note regarding reservation contribution / deposit / bank transfer" },
        "receipt_note": { "type": "string", "description": "Note instructing guests to send payment receipt via WhatsApp" },
        "custom_note": { "type": "string", "description": "Additional optional note" }
      }
    },
    "faqs_section": {
      "type": "object",
      "required": ["type", "items"],
      "properties": {
        "type": { "type": "string", "enum": ["faqs"] },
        "surface": { "$ref": "#/definitions/section_surface" },
        "title": { "type": "string", "description": "FAQs section heading" },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["question", "answer"],
            "properties": {
              "question": { "type": "string" },
              "answer": { "type": "string" }
            }
          }
        }
      }
    },
    "gift_registry_section": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "enum": ["gift_registry"] },
        "surface": { "$ref": "#/definitions/section_surface" },
        "message": { "type": "string" },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "url"],
            "properties": {
              "label": { "type": "string" },
              "url": { "type": "string" }
            }
          }
        }
      }
    },
    "closing_section": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "enum": ["closing"] },
        "surface": { "$ref": "#/definitions/section_surface" },
        "message": { "type": "string", "description": "Warm farewell or excitement message" },
        "signoff": { "type": "string", "description": "Sign-off phrase (e.g. With love, Warmly, Cheers)" },
        "hosts": { "type": "string", "description": "Custom host sign-off names (e.g. Sarah & Alex)" }
      }
    }
  }
}
